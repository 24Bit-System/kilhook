# Normalise text in the repository; Windows checkouts get CRLF as usual.
* text=auto

# Frontend sources use LF everywhere: Vite copies index.html into dist, so a
# CRLF checkout would generate a CRLF bundle that differs from the committed
# one on every rebuild. The content-hash gate is newline-insensitive, but the
# worktree should still stay clean after `npm run build`.
cmd/kh-app/frontend/** text eol=lf

# The frontend bundle is generated by Vite and embedded verbatim into the
# binary. Keep its bytes exactly as built so `npm run build` on a fresh clone
# leaves no spurious diff (core.autocrlf would otherwise rewrite it).
cmd/kh-app/frontend/dist/** -text

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.woff2 binary
*.syso binary
