<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kh-app.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Kilhook">
    </Installer>
    <PackageInformation
        PackageName="kilhook"
        PackageDisplayName="kilhook"
        PublisherName="CN=24Bit System"
        PublisherDisplayName="24Bit System"
        Version="0.1.0.0"
        PackageDescription="Local-first API workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kilhook.app"
                Description="Local-first API workbench"
                DisplayName="kilhook"
                ExecutableName="kh-app.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>kilhook</DisplayName>
            <PublisherDisplayName>Kilhook</PublisherDisplayName>
            <Description>Local-first API workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kh-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
